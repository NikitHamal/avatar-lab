{
  "name": "@bible-strong/avatar-web",
  "version": "0.1.0",
  "description": "Framework-independent DOM renderer for Bible Strong procedural avatars.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bible-strong/avatar-core": "workspace:^"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.0.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
